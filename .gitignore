# --- Tauri / Rust ---
src-tauri/target/
src-tauri/gen/

# --- Secrets ---
.env
.env.*
!.env.example

# --- Klide workspace state ---
# Project Memory notes are local/private by default. Repos that want shared
# memory can explicitly unignore this path in their own git policy.
.klide/memory/
# Mission specs and append-only runtime events are local/private by default.
# A repo can explicitly unignore or export authored mission Markdown later.
.klide/missions/

# Inter-agent envelopes, normalized Run state, and results are local durable
# runtime evidence. The journal may quote prompts and Workspace paths.
.klide/coordination/
# Per-conversation agent todo stores — run scratch state, never repo content.
.agents/todos/

# --- Prompt A/B harness output ---
scripts/prompt-ab/results.json

# --- OS noise ---
Thumbs.db

# --- Local demo output ---
# Files a dogfood run produced (decks, docs, rendered pages). Never repo content.
artifacts/
q3-demo/
