{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klide Design Parity",
  "identifier": "com.pierre.klide.design-parity",
  "build": {
    "devUrl": "http://127.0.0.1:1465/preview/design-feedback.html?desktop=1&scenario=tools-and-review&theme=klide-light",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Klide — Design parity", "titleBarStyle": "Overlay", "hiddenTitle": false, "width": 1440, "height": 900, "minWidth": 900, "minHeight": 640, "visible": false, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost" }
  }
}
