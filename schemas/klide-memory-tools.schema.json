{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klide.dev/schemas/klide-memory-tools.schema.json",
  "title": "Klide Memory Tool call",
  "description": "Provider-neutral call contract shared by the native Harness and authenticated embedded MCP adapter.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "memory_search"
        },
        "arguments": {
          "$ref": "#/$defs/memorySearchInput"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "memory_read"
        },
        "arguments": {
          "$ref": "#/$defs/memoryReadInput"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "memory_propose"
        },
        "arguments": {
          "$ref": "#/$defs/memoryProposeInput"
        }
      }
    }
  ],
  "$defs": {
    "memoryKind": {
      "type": "string",
      "enum": [
        "run",
        "handoff",
        "decision",
        "convention",
        "fact",
        "failure",
        "pattern"
      ]
    },
    "memorySearchInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/memoryKind"
          }
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "includeInactive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "memoryReadInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryId"
      ],
      "properties": {
        "memoryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 180
        }
      }
    },
    "memorySearchHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "score",
        "matchedFields",
        "excerpt"
      ],
      "properties": {
        "entry": {
          "$ref": "klide-memory-entry.schema.json"
        },
        "score": {
          "type": "integer",
          "minimum": 1
        },
        "matchedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "title",
              "goal",
              "notes",
              "runId",
              "decisions",
              "filesTouched",
              "tags",
              "sourceRefs"
            ]
          }
        },
        "excerpt": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "memoryProposeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "kind",
        "notes",
        "why",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "decision",
            "convention",
            "fact",
            "failure",
            "pattern"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "quote"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      }
    }
  }
}
